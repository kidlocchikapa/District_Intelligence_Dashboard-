PORT=5000

# Leave blank to use the local PostGIS container defined in docker-compose.yml.
DATABASE_URL=

DB_HOST=db
DB_PORT=5432
DB_NAME=district_intelligence
DB_USER=district_user
DB_PASSWORD=district_password

# Change this for any shared or non-local environment.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# Comma-separated list of allowed frontend origins for CORS.
# Example:
# CORS_ALLOWED_ORIGINS=https://district-intelligence-dashboard.vercel.app,https://your-preview.vercel.app
CORS_ALLOWED_ORIGINS=https://district-intelligence-dashboard.vercel.app
